# Upstash Redis (Vercel KV) credentials.
# Added automatically when you install the Upstash integration from the Vercel
# Marketplace; pull them locally with `vercel env pull .env.development.local`.
#
# If these are unset, Pulse falls back to a process-local in-memory store
# (data is NOT persisted across restarts) so it still runs and builds.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
